rules_version = '2';

// Estas reglas son la ÚNICA barrera real entre tus credenciales guardadas
// y cualquier persona en internet: la apiKey del cliente es pública por
// diseño, así que sin estas reglas los datos de "profiles" y "coupons"
// serían legibles por cualquiera que conozca tu projectId.
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo un usuario autenticado (tú, el admin, dado de alta manualmente
    // en Firebase Authentication) puede leer o escribir.
    match /profiles/{profileId} {
      allow read, write: if request.auth != null;
    }

    match /coupons/{couponId} {
      allow read, write: if request.auth != null;
    }

    // Bloquea todo lo demás por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
